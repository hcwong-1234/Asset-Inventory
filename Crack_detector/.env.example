# Example configuration only.
# Keep real values in .env, which is ignored by git.

# Output folder for generated reports
OUTPUT_DIR=./logs

# Inventory collection options
INCLUDE_APPX_PACKAGES=true
EVENT_LOOKBACK_HOURS=24
MAX_EVENTS_PER_LOG=200
MAX_PROCESS_HASHES=150
PRETTY_JSON=true

# Optional future integration targets
SIEM_PROVIDER=
SIEM_ENDPOINT=
SIEM_API_KEY=

# Optional SMTP / notification settings
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
ALERT_EMAIL_TO=
